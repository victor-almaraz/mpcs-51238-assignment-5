{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sphaerenmusik/ir.schema.json",
  "title": "Sphärenmusik piece IR, version 1",
  "description": "Structure of the IR (doc/piece-dsl.md, IR). Ranges, vocabularies and references are semantic checks in src/dsl/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "seed", "tempo", "scale", "instruments", "master", "lfos", "mods", "bindings", "reactions", "view", "layers", "groups", "localOnly"],
  "properties": {
    "irVersion": { "type": "integer" },
    "seed": { "type": "integer" },
    "tempo": { "type": "number" },
    "scale": {
      "type": "object", "additionalProperties": false, "required": ["root", "mode"],
      "properties": { "root": { "type": "string" }, "mode": { "type": "string" } }
    },
    "instruments": { "type": "array", "items": { "$ref": "#/$defs/instrument" } },
    "master": {
      "type": "object", "additionalProperties": false, "required": ["fx"],
      "properties": { "fx": { "$ref": "#/$defs/chain" } }
    },
    "lfos": { "type": "array", "items": { "$ref": "#/$defs/lfo" } },
    "mods": { "type": "array", "items": { "$ref": "#/$defs/mod" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "reactions": { "type": "array", "items": { "$ref": "#/$defs/reaction" } },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["projection", "background"],
      "properties": { "projection": { "type": "string" }, "background": { "$ref": "#/$defs/value" } }
    },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "groups": { "type": "array", "items": { "type": "string" } },
    "localOnly": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]+[0-9]+$" },
    "expr": {
      "type": "object", "additionalProperties": false, "required": ["op", "args"],
      "properties": {
        "op": { "type": "string" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      }
    },
    "value": {
      "anyOf": [
        { "type": "number" }, { "type": "string" }, { "type": "boolean" }, { "type": "null" },
        { "$ref": "#/$defs/expr" }
      ]
    },
    "select": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["top", "by", "order"],
          "properties": { "top": { "type": "integer" }, "by": { "type": "string" }, "order": { "type": "string" } }
        }
      ]
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "params", "bypass"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "params": { "type": "object" },
        "bypass": { "type": "boolean" }
      }
    },
    "chain": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
    "instrument": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "volumeDb", "octave", "cents", "params", "fx"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "volumeDb": { "type": "number" },
        "octave": { "type": "integer" },
        "cents": { "type": "number" },
        "params": { "type": "object" },
        "fx": { "$ref": "#/$defs/chain" }
      }
    },
    "lfo": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "shape", "rate", "phase", "retrigger", "smooth"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "shape": { "type": "string" },
        "rate": {
          "anyOf": [
            { "type": "number" },
            { "type": "object", "additionalProperties": false, "required": ["sync"], "properties": { "sync": { "type": "string" } } },
            {
              "type": "object", "additionalProperties": false, "required": ["expr", "min", "max"],
              "properties": { "expr": { "$ref": "#/$defs/expr" }, "min": { "type": "number" }, "max": { "type": "number" } }
            }
          ]
        },
        "phase": { "type": "number" },
        "retrigger": { "type": "boolean" },
        "smooth": { "type": "number" }
      }
    },
    "mod": {
      "type": "object", "additionalProperties": false, "required": ["target", "source", "depth", "smoothMs"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z]+[0-9]+\\.[A-Za-z0-9_]+$" },
        "source": {
          "anyOf": [
            { "type": "object", "additionalProperties": false, "required": ["lfo"], "properties": { "lfo": { "$ref": "#/$defs/id" } } },
            { "type": "object", "additionalProperties": false, "required": ["expr"], "properties": { "expr": { "$ref": "#/$defs/expr" } } }
          ]
        },
        "depth": { "type": "number" },
        "smoothMs": { "type": "number" }
      }
    },
    "binding": {
      "anyOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "inst", "group", "select", "pitch", "velocity", "pan", "voiceMods"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "voices" }, "inst": { "$ref": "#/$defs/id" },
            "group": { "type": "string" }, "select": { "$ref": "#/$defs/select" },
            "pitch": { "$ref": "#/$defs/value" }, "velocity": { "$ref": "#/$defs/value" }, "pan": { "$ref": "#/$defs/value" },
            "voiceMods": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "inst", "group", "select", "event", "when", "pitch", "velocity", "durationMs", "maxPerSecond"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "trigger" }, "inst": { "$ref": "#/$defs/id" },
            "group": { "type": "string" }, "select": { "$ref": "#/$defs/select" }, "event": { "type": "string" },
            "when": { "$ref": "#/$defs/value" }, "pitch": { "$ref": "#/$defs/value" }, "velocity": { "$ref": "#/$defs/value" },
            "durationMs": { "type": "number" }, "maxPerSecond": { "type": "number" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "inst", "param", "expr", "smoothMs"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "param" }, "inst": { "$ref": "#/$defs/id" },
            "param": { "type": "string" }, "expr": { "$ref": "#/$defs/value" }, "smoothMs": { "type": "number" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "slot", "param", "expr", "smoothMs"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "fxParam" }, "slot": { "$ref": "#/$defs/id" },
            "param": { "type": "string" }, "expr": { "$ref": "#/$defs/value" }, "smoothMs": { "type": "number" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "slot", "expr"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "fxBypass" }, "slot": { "$ref": "#/$defs/id" },
            "expr": { "$ref": "#/$defs/value" }
          }
        }
      ]
    },
    "reaction": {
      "type": "object", "additionalProperties": false, "required": ["on", "source", "actions"],
      "properties": {
        "on": { "type": "string" },
        "source": { "type": "string" },
        "actions": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "detuneCents": { "type": "number" },
            "mute": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "only": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "desaturate": { "type": "number" }
          }
        }
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "group", "select", "props"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "group": { "type": ["string", "null"] },
        "select": { "$ref": "#/$defs/select" },
        "glsl": { "type": "string" },
        "props": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      }
    }
  }
}
